{
  "name": "cloudflare-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:dev": "wrangler pages dev out --compatibility-date=2025-03-07",
    "pages:deploy": "wrangler pages deploy out",
    "deploy:preview": "npm run build && wrangler pages deploy out --project-name=savo",
    "deploy:production": "npm run build && wrangler pages deploy out --project-name=savo --branch=main"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.8.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.29.0"
  }
}
