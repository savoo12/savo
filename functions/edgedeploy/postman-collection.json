{
  "info": {
    "name": "EdgeDeploy API",
    "description": "API for managing Next.js deployments on Cloudflare",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Check API status"
      }
    },
    {
      "name": "List Projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects"]
        },
        "description": "List all projects"
      }
    },
    {
      "name": "Get Project",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "Get a project by ID"
      }
    },
    {
      "name": "Create Project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My Next.js App\",\n  \"framework\": \"nextjs\",\n  \"repositoryUrl\": \"https://github.com/username/repo\",\n  \"buildCommand\": \"npm run build\",\n  \"outputDirectory\": \"out\",\n  \"environmentVariables\": {\n    \"NODE_ENV\": \"production\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects"]
        },
        "description": "Create a new project"
      }
    },
    {
      "name": "Update Project",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated App Name\",\n  \"buildCommand\": \"npm run build:prod\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "Update an existing project"
      }
    },
    {
      "name": "List Deployments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/deployments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "deployments"]
        },
        "description": "List all deployments for a project"
      }
    },
    {
      "name": "Get Deployment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/deployments/{{deploymentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "deployments", "{{deploymentId}}"]
        },
        "description": "Get a deployment by ID"
      }
    },
    {
      "name": "Trigger Deployment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"branch\": \"main\",\n  \"commit\": {\n    \"hash\": \"abcdef123456\",\n    \"message\": \"Update readme\",\n    \"author\": \"developer@example.com\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/deploy",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "deploy"]
        },
        "description": "Trigger a new deployment"
      }
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://edgedeploy-api.your-subdomain.workers.dev",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "PROJECT_ID",
      "type": "string"
    },
    {
      "key": "deploymentId",
      "value": "DEPLOYMENT_ID",
      "type": "string"
    }
  ]
} 